<!doctype html>
<html><head><meta charset="utf-8"><title>{{ p.name }} Resume</title>
<style>
  {{ fonts_css }}
  /* ATS-friendly: one column, real text, standard headings, no tables or images. */
  @page { size: Letter; margin: 0.5in 0.6in; }
  body { font-family: "Source Sans 3", Arial, Helvetica, sans-serif; font-size: 10.5pt; line-height: 1.3;
         color: #1a1a1a; margin: 0; }
  a { color: #1a4f9c; text-decoration: underline; text-decoration-thickness: 0.5px; text-underline-offset: 1.5px; }
  h1 { font-size: 20pt; font-weight: 700; margin: 0; text-align: center; letter-spacing: 0.2px; }
  .contact { text-align: center; font-size: 9.8pt; margin: 2px 0 4px; }
  .contact .sep { color: #888; margin: 0 4px; }
  .contact .item { white-space: nowrap; }  /* wrap between items, never inside a link */
  h2 { font-size: 10.8pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.9px; color: #1a1a1a;
       border-bottom: 0.8px solid #1a1a1a; margin: 10px 0 4px; padding-bottom: 1.5px; }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: 14px; }
  .row > span:last-child { white-space: nowrap; }
  .entry { margin-bottom: 6px; }
  .entry:last-child { margin-bottom: 0; }
  .what { font-weight: 700; }
  .meta { color: #444; }
  ul { margin: 2px 0 0 0; padding-left: 15px; }
  li { margin: 0 0 1.5px 0; padding-left: 1px; }
  p { margin: 0; }
  .skills p { margin-bottom: 2px; }
  .skills b { font-weight: 600; }
</style></head>
<body>
<h1>{{ p.name }}</h1>
<div class="contact">
  <span class="item">{{ p.location }}</span><span class="sep">|</span><span class="item">{{ p.phone }}</span><span class="sep">|</span><a class="item" href="mailto:{{ p.email }}">{{ p.email }}</a><span class="sep">|</span><a class="item" href="{{ p.linkedin }}">LinkedIn</a><span class="sep">|</span><a class="item" href="{{ p.github }}">GitHub</a>
  {% if p.us_citizen and not p.needs_sponsorship %}<br><span class="item">U.S. Citizen</span><span class="sep">|</span><span class="item">No sponsorship required</span>{% endif %}
</div>

{% if summary %}<h2>Summary</h2><p>{{ summary }}</p>{% endif %}

{% for section in sections %}
{% if section == "experience" and experience %}
<h2>Experience</h2>
{% for e in experience %}
<div class="entry">
  <div class="row"><span><span class="what">{{ e.title }}</span>, {{ e.company }}{% if e.location %}<span class="meta"> · {{ e.location }}</span>{% endif %}</span><span>{{ e.dates }}</span></div>
  <ul>{% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
</div>
{% endfor %}
{% elif section == "projects" and projects %}
<h2>Projects</h2>
{% for e in projects %}
<div class="entry">
  <div><span class="what">{{ e.name }}</span>{% if e.tech %}<span class="meta"> | {{ e.tech | join(", ") }}</span>{% endif %}{% if e.link %}<span class="meta"> | </span><a href="{{ e.link }}">{{ "GitHub" if "github.com" in e.link else "Live Demo" }}</a>{% endif %}</div>
  <ul>{% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
</div>
{% endfor %}
{% elif section == "skills" and skills %}
<h2>Skills</h2>
<div class="skills">{% for s in skills %}<p><b>{{ s.category }}:</b> {{ s["items"] | join(", ") }}</p>{% endfor %}</div>
{% elif section == "education" %}
<h2>Education</h2>
{% for ed in education %}
<div class="entry">
  <div class="row"><span><span class="what">{{ ed.degree }}</span></span><span>{{ ed.dates }}</span></div>
  <div>{{ ed.school }}{% if ed.location %}, {{ ed.location }}{% endif %}{% if ed.gpa %}<span class="sep"> | </span>CGPA: {{ ed.gpa }}{% endif %}</div>
  {% for n in ed.notes %}<div>{{ n }}</div>{% endfor %}
</div>
{% endfor %}
{% elif section == "certifications" and certifications %}
<h2>Certifications</h2>
<ul>{% for c in certifications %}<li>{{ c }}</li>{% endfor %}</ul>
{% elif section == "leadership" and achievements %}
<h2>Leadership</h2>
<ul>{% for a in achievements %}<li>{{ a }}</li>{% endfor %}</ul>
{% endif %}
{% endfor %}
</body></html>
